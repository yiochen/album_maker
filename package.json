{
  "name": "album_app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate-schema && GOOGLE_REDIRECT_URI=http://localhost:5173/edit npx netlify dev --command \"npm run dev:vite\" --target-port 5173",
    "dev:vite": "vite",
    "build": "npm run generate-schema && tsc -b && vite build",
    "generate-schema": "ts-json-schema-generator --path 'src/types/index.ts' --type 'Album' --out 'src/schemas/albumSchema.json' --tsconfig 'tsconfig.app.json'",
    "lint": "npm run generate-schema && eslint . && tsc -b --noEmit",
    "preview": "vite preview",
    "pw:open": "playwright test --ui",
    "pw:run": "playwright test",
    "pw:run:update": "playwright test --update-snapshots",
    "test:e2e": "start-server-and-test \"npm run generate-schema && npm run dev:vite\" http://localhost:5173 pw:run",
    "clean-port": "kill -9 $(lsof -t -i:5173)"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-color": "^3.20.0",
    "@tiptap/extension-font-family": "^3.20.0",
    "@tiptap/extension-text-style": "^3.20.0",
    "@tiptap/extension-underline": "^3.20.0",
    "@tiptap/pm": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@types/file-saver": "^2.0.7",
    "ajv": "^8.17.1",
    "dexie": "^4.2.1",
    "exifr": "^7.1.3",
    "fabric": "^7.1.0",
    "file-saver": "^2.0.5",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/google.accounts": "^0.0.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "start-server-and-test": "^2.1.3",
    "playwright": "^1.58.2",
    "ts-json-schema-generator": "^2.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
